# Kopiere diese Datei nach .env und trage deine Schlüssel ein
# (https://dev-portal.onshape.com -> API-Schlüssel)
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# Längeneinheit für alle Tools: mm (Standard) | cm | m | in
ONSHAPE_LENGTH_UNIT=mm

# Neue Dokumente öffentlich anlegen? Education-/Bezahl-Konto: false (privat).
# Kostenloses Konto erlaubt nur öffentliche Dokumente -> true.
ONSHAPE_DOCUMENTS_PUBLIC=false
